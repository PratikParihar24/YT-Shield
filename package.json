{
  "name": "yt-shield",
  "version": "1.0.0",
  "description": "Minimalistic YouTube advertisement minimizing and playback recovery extension",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && vite build --mode content",
    "build:base": "vite build",
    "build:content": "vite build --mode content",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "chrome-extension",
    "youtube",
    "ad-block",
    "playback-recovery"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
